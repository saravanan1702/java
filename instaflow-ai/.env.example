# =============================================================================
# InstaFlow AI — environment configuration (PLACEHOLDERS ONLY)
# Copy to `.env` for local development. Never commit a real `.env`.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # CSRF_SECRET
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))" # TOKEN_ENCRYPTION_KEYS
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of the web app (used in email links) and allowed browser origins
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Reverse-proxy hops to trust for client IPs (set to 1 behind a single load balancer)
TRUST_PROXY=0

# --- Database & Redis --------------------------------------------------------
DATABASE_URL=postgresql://instaflow:change-me@localhost:5432/instaflow
# Omit REDIS_URL to run without Redis (jobs run inline, in-memory rate limiting)
REDIS_URL=redis://localhost:6379

# --- Sessions & security -----------------------------------------------------
SESSION_TTL_DAYS=30
# true in production (HTTPS). "none" SameSite requires COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional parent domain when web and API are on sibling subdomains (e.g. .example.com)
COOKIE_DOMAIN=
CSRF_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated "<version>:<base64 32-byte key>" — keep old versions to decrypt during rotation
TOKEN_ENCRYPTION_KEYS=1:change-me-base64-32-byte-key
TOKEN_ENCRYPTION_ACTIVE_VERSION=1
RATE_LIMIT_ENABLED=true

# --- Email -------------------------------------------------------------------
# smtp | log | file | memory   (docker compose dev uses Mailpit via smtp)
MAIL_TRANSPORT=file
MAIL_FROM="InstaFlow AI <no-reply@example.com>"
MAIL_OUTBOX_DIR=.mail-outbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Queues / worker ---------------------------------------------------------
# queue (BullMQ, needs REDIS_URL) | inline (in-process; dev without Redis, tests)
QUEUE_MODE=queue
WORKER_HEALTH_PORT=4001

# --- Seeding (optional, local only) -----------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# --- Web app (Vite) ----------------------------------------------------------
# Leave empty to use same-origin /api (Vite dev proxy or reverse proxy in prod)
VITE_API_URL=
# Where the Vite dev server proxies /api
VITE_DEV_API_PROXY=http://localhost:4000

# --- Meta / Instagram (Phase 2 — not used yet) -------------------------------
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=
# META_WEBHOOK_VERIFY_TOKEN=
