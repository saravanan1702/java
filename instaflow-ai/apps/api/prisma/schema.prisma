// =============================================================================
// InstaFlow AI — PostgreSQL schema
//
// Tenancy rules (see docs/ARCHITECTURE.md §Tenancy):
//  * Every tenant-owned table has a non-null `workspaceId`.
//  * Child → parent relations inside a tenant use COMPOSITE foreign keys
//    (parentId, workspaceId) → parent(id, workspaceId), so the database itself
//    rejects a child that points at another workspace's parent.
//  * WebhookEvent and AuditLog have a NULLABLE workspaceId: webhooks arrive
//    before the workspace is identified, and some audit events (login) are
//    user-level. Both are written only by trusted server code.
//  * Secrets are stored hashed (session/verification/invite tokens) or
//    encrypted with AES-256-GCM (OAuth access tokens). Never returned by the API.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
}

enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
}

enum WorkspaceLanguage {
  EN
  TA
  TA_LATN
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum InstagramAccountStatus {
  ACTIVE
  TOKEN_EXPIRING
  TOKEN_EXPIRED
  REVOKED
  DISCONNECTED
  ERROR
}

/// Result of capability detection for comment webhooks on a media item.
enum CapabilityStatus {
  UNKNOWN
  SUPPORTED
  UNSUPPORTED
}

enum MediaAutomationState {
  ENABLED
  PAUSED
  DISABLED
}

enum AutomationTrigger {
  COMMENT
  DIRECT_MESSAGE
}

enum RuleMediaScope {
  /// Global rule: applies to all eligible media (minus excluded media)
  ALL_MEDIA
  /// Applies only to media linked through AutomationRuleMedia
  SELECTED_MEDIA
  /// Not media-bound (e.g. direct-message keyword rules)
  NONE
}

enum KeywordMatchType {
  EXACT
  CONTAINS
  STARTS_WITH
}

enum RuleAction {
  SEND_TEMPLATE
  HUMAN_HANDOVER
  START_FLOW
  AI_REPLY
}

enum FlowStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ConversationStatus {
  OPEN
  PENDING_HUMAN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  CUSTOMER
  KEYWORD_RULE
  FLOW
  AI
  AGENT
  PRIVATE_REPLY
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  FAILED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum KnowledgeSource {
  PRODUCT
  FAQ
  POLICY
  CUSTOM
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum ExecutionStatus {
  PENDING
  SKIPPED
  SENT
  FAILED
  RETRYING
}

enum UsageMetric {
  AI_REQUESTS
  AI_INPUT_TOKENS
  AI_OUTPUT_TOKENS
  DMS_SENT
  PRIVATE_REPLIES_SENT
  WEBHOOK_EVENTS
}

// -----------------------------------------------------------------------------
// Identity & sessions (platform-level, not tenant-owned)
// -----------------------------------------------------------------------------

model User {
  id               String       @id @default(uuid()) @db.Uuid
  /// Stored normalized: trimmed + lower-cased
  email            String       @unique @db.VarChar(254)
  passwordHash     String
  name             String       @db.VarChar(80)
  emailVerifiedAt  DateTime?
  platformRole     PlatformRole @default(USER)
  lastWorkspaceId  String?      @db.Uuid
  failedLoginCount Int          @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sessions           Session[]
  verificationTokens VerificationToken[]
  memberships        WorkspaceMember[]
  invitationsSent    WorkspaceInvitation[] @relation("InvitedBy")
  auditLogs          AuditLog[]
  connectedAccounts  InstagramAccount[]    @relation("ConnectedBy")
  messagesSent       Message[]             @relation("SentBy")
  notes              ConversationNote[]
  assignedChats      Conversation[]        @relation("AssignedTo")
  flowVersions       FlowVersion[]

  @@index([deletedAt])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 of the opaque session token held in the httpOnly cookie
  tokenHash  String    @unique @db.VarChar(64)
  userAgent  String?   @db.VarChar(512)
  ip         String?   @db.VarChar(64)
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// -----------------------------------------------------------------------------
// Workspaces (tenants)
// -----------------------------------------------------------------------------

model Workspace {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(60)
  slug            String            @unique @db.VarChar(80)
  plan            WorkspacePlan     @default(FREE)
  timezone        String            @default("Asia/Kolkata") @db.VarChar(64)
  defaultLanguage WorkspaceLanguage @default(EN)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  oauthTokens       OAuthToken[]
  media             InstagramMedia[]
  automationRules   AutomationRule[]
  keywords          AutomationKeyword[]
  ruleMedia         AutomationRuleMedia[]
  flows             AutomationFlow[]
  flowVersions      FlowVersion[]
  conversations     Conversation[]
  notes             ConversationNote[]
  messages          Message[]
  products          Product[]
  knowledgeDocs     KnowledgeDocument[]
  webhookEvents     WebhookEvent[]
  executions        AutomationExecution[]
  usageRecords      UsageRecord[]
  auditLogs         AuditLog[]

  @@index([deletedAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  invitedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  email       String        @db.VarChar(254)
  role        WorkspaceRole
  /// SHA-256 of the invitation token sent by email
  tokenHash   String        @unique @db.VarChar(64)
  invitedById String?       @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([email])
}

// -----------------------------------------------------------------------------
// Instagram integration (Phase 2)
// -----------------------------------------------------------------------------

model InstagramAccount {
  id                String                 @id @default(uuid()) @db.Uuid
  workspaceId       String                 @db.Uuid
  /// Instagram professional account ID as returned by Meta's API
  igUserId          String                 @db.VarChar(64)
  username          String                 @db.VarChar(64)
  name              String?                @db.VarChar(160)
  profilePictureUrl String?
  accountType       String?                @db.VarChar(32)
  status            InstagramAccountStatus @default(ACTIVE)
  statusReason      String?
  /// Scopes actually granted by the user (may be fewer than requested)
  grantedScopes     String[]
  webhookSubscribed Boolean                @default(false)
  /// True when this account is served by the clearly-labelled local mock adapter
  isMock            Boolean                @default(false)
  connectedById     String?                @db.Uuid
  lastSyncedAt      DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy   User?                 @relation("ConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  token         OAuthToken?
  media         InstagramMedia[]
  rules         AutomationRule[]
  flows         AutomationFlow[]
  conversations Conversation[]
  executions    AutomationExecution[]

  @@unique([id, workspaceId])
  /// One connection row per IG account per workspace. Cross-workspace
  /// double-connection of an ACTIVE account is rejected in the service layer.
  @@unique([workspaceId, igUserId])
  @@index([igUserId])
  @@index([status])
}

model OAuthToken {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  instagramAccountId String    @unique @db.Uuid
  provider           String    @default("instagram") @db.VarChar(32)
  /// AES-256-GCM ciphertext: "<keyVersion>.<iv>.<authTag>.<ciphertext>" (base64url parts)
  accessTokenEnc     String
  encKeyVersion      Int
  tokenType          String?   @db.VarChar(32)
  expiresAt          DateTime?
  lastRefreshedAt    DateTime?
  refreshFailures    Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([instagramAccountId, workspaceId])
  @@index([workspaceId])
  @@index([expiresAt])
}

model InstagramMedia {
  id                    String               @id @default(uuid()) @db.Uuid
  workspaceId           String               @db.Uuid
  instagramAccountId    String               @db.Uuid
  igMediaId             String               @db.VarChar(64)
  /// Raw media_type from Meta (e.g. IMAGE, VIDEO, CAROUSEL_ALBUM); stored as text, not invented enums
  mediaType             String?              @db.VarChar(32)
  /// Raw media_product_type from Meta (e.g. FEED, REELS, STORY, AD)
  mediaProductType      String?              @db.VarChar(32)
  caption               String?
  permalink             String?
  thumbnailUrl          String?
  mediaUrl              String?
  postedAt              DateTime?
  automationState       MediaAutomationState @default(ENABLED)
  /// Excluded from global (ALL_MEDIA) rules
  globalRulesExcluded   Boolean              @default(false)
  commentWebhookSupport CapabilityStatus     @default(UNKNOWN)
  capabilityNote        String?
  firstSeenAt           DateTime             @default(now())
  lastSyncedAt          DateTime?
  deletedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount      @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  ruleLinks        AutomationRuleMedia[]
  executions       AutomationExecution[]

  @@unique([id, workspaceId])
  @@unique([instagramAccountId, igMediaId])
  @@index([workspaceId, instagramAccountId, postedAt(sort: Desc)])
  @@index([workspaceId, mediaProductType])
}

// -----------------------------------------------------------------------------
// Automation engine (Phase 3 / 5)
// -----------------------------------------------------------------------------

model AutomationRule {
  id                 String            @id @default(uuid()) @db.Uuid
  workspaceId        String            @db.Uuid
  instagramAccountId String            @db.Uuid
  name               String            @db.VarChar(120)
  trigger            AutomationTrigger @default(COMMENT)
  mediaScope         RuleMediaScope    @default(SELECTED_MEDIA)
  matchType          KeywordMatchType  @default(CONTAINS)
  caseSensitive      Boolean           @default(false)
  /// Apply language normalization (Unicode NFKC, whitespace/punctuation folding, Tanglish variants)
  normalizeText      Boolean           @default(true)
  /// Lower number = higher priority. Used for conflict resolution.
  priority           Int               @default(100)
  action             RuleAction        @default(SEND_TEMPLATE)
  replyTemplate      String?
  /// Optional public comment reply text (separate from the private reply DM)
  publicReplyText    String?
  flowId             String?           @db.Uuid
  enabled            Boolean           @default(true)
  lastExecutedAt     DateTime?
  executionCount     Int               @default(0)
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount      @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  flow             AutomationFlow?       @relation(fields: [flowId], references: [id], onDelete: SetNull)
  keywords         AutomationKeyword[]
  mediaLinks       AutomationRuleMedia[]
  executions       AutomationExecution[]

  @@unique([id, workspaceId])
  @@index([workspaceId, instagramAccountId, enabled, priority])
  @@index([workspaceId, deletedAt])
}

model AutomationKeyword {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  ruleId      String   @db.Uuid
  keyword     String   @db.VarChar(100)
  /// Pre-computed normalized form used by the matcher
  normalized  String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule @relation(fields: [ruleId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([ruleId, normalized])
  @@index([workspaceId, normalized])
}

/// Join table: which media a SELECTED_MEDIA rule applies to.
model AutomationRuleMedia {
  workspaceId String   @db.Uuid
  ruleId      String   @db.Uuid
  mediaId     String   @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      AutomationRule @relation(fields: [ruleId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  media     InstagramMedia @relation(fields: [mediaId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([ruleId, mediaId])
  @@index([workspaceId, mediaId])
}

model AutomationFlow {
  id                 String     @id @default(uuid()) @db.Uuid
  workspaceId        String     @db.Uuid
  instagramAccountId String?    @db.Uuid
  name               String     @db.VarChar(120)
  description        String?
  status             FlowStatus @default(DRAFT)
  /// Version currently executed when status = ACTIVE
  activeVersion      Int?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount?     @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  versions         FlowVersion[]
  rules            AutomationRule[]
  executions       AutomationExecution[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}

/// Immutable, versioned flow definition (JSON graph validated server-side).
model FlowVersion {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  flowId        String    @db.Uuid
  version       Int
  /// Definition schema version, so old graphs can be migrated
  schemaVersion Int       @default(1)
  definition    Json
  validatedAt   DateTime?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow      AutomationFlow @relation(fields: [flowId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([flowId, version])
  @@index([workspaceId])
}

// -----------------------------------------------------------------------------
// Inbox (Phase 4)
// -----------------------------------------------------------------------------

model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @db.Uuid
  instagramAccountId String             @db.Uuid
  /// Instagram-scoped ID of the customer
  igScopedUserId     String             @db.VarChar(64)
  customerUsername   String?            @db.VarChar(64)
  customerName       String?            @db.VarChar(160)
  status             ConversationStatus @default(OPEN)
  aiPaused           Boolean            @default(false)
  humanTakeover      Boolean            @default(false)
  assignedToId       String?            @db.Uuid
  tags               String[]
  unreadCount        Int                @default(0)
  /// Last customer-initiated message; drives the messaging-window eligibility check
  lastInboundAt      DateTime?
  lastMessageAt      DateTime?
  isLead             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount      @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  assignedTo       User?                 @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages         Message[]
  notes            ConversationNote[]
  executions       AutomationExecution[]

  @@unique([id, workspaceId])
  @@unique([instagramAccountId, igScopedUserId])
  @@index([workspaceId, lastMessageAt(sort: Desc)])
  @@index([workspaceId, status])
}

model ConversationNote {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  conversationId String   @db.Uuid
  authorId       String?  @db.Uuid
  body           String
  createdAt      DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, conversationId])
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  conversationId String           @db.Uuid
  direction      MessageDirection
  source         MessageSource
  text           String?
  /// Message ID returned by / received from Meta
  igMessageId    String?          @db.VarChar(255)
  status         MessageStatus
  error          String?
  sentById       String?          @db.Uuid
  executionId    String?          @db.Uuid
  metadata       Json?
  createdAt      DateTime         @default(now())

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation         @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sentBy       User?                @relation("SentBy", fields: [sentById], references: [id], onDelete: SetNull)
  execution    AutomationExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  /// Inbound webhook redelivery must not create duplicate messages
  @@unique([workspaceId, igMessageId])
  @@index([workspaceId, conversationId, createdAt])
}

// -----------------------------------------------------------------------------
// Product knowledge (Phase 4)
// -----------------------------------------------------------------------------

model Product {
  id              String      @id @default(uuid()) @db.Uuid
  workspaceId     String      @db.Uuid
  name            String      @db.VarChar(160)
  description     String?
  /// Null = price not provided; the AI must then say the team will confirm
  price           Decimal?    @db.Decimal(12, 2)
  currency        String      @default("INR") @db.Char(3)
  url             String?
  imageUrl        String?
  stockStatus     StockStatus @default(UNKNOWN)
  colours         String[]
  deliveryDetails String?
  returnPolicy    String?
  /// [{ "question": string, "answer": string }]
  faq             Json?
  /// Only approved products are used for AI retrieval
  isApproved      Boolean     @default(true)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]

  @@unique([id, workspaceId])
  @@index([workspaceId, deletedAt])
}

model KnowledgeDocument {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  productId   String?         @db.Uuid
  source      KnowledgeSource
  title       String          @db.VarChar(200)
  content     String
  /// Detects stale derived documents when the source product changes
  contentHash String          @db.VarChar(64)
  isApproved  Boolean         @default(true)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isApproved, deletedAt])
  @@index([productId])
}

// -----------------------------------------------------------------------------
// Event pipeline & observability
// -----------------------------------------------------------------------------

model WebhookEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  /// Null until the receiving Instagram account is mapped to a workspace
  workspaceId        String?            @db.Uuid
  instagramAccountId String?            @db.Uuid
  provider           String             @default("instagram") @db.VarChar(32)
  /// e.g. "comments", "messages"
  field              String             @db.VarChar(64)
  /// Stable de-duplication key derived from the event (e.g. "comments:<commentId>")
  dedupeKey          String             @unique @db.VarChar(255)
  signatureValid     Boolean
  payload            Json
  status             WebhookEventStatus @default(RECEIVED)
  attempts           Int                @default(0)
  error              String?
  receivedAt         DateTime           @default(now())
  processedAt        DateTime?

  workspace  Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@index([workspaceId, receivedAt])
  @@index([status, receivedAt])
}

model AutomationExecution {
  id                 String            @id @default(uuid()) @db.Uuid
  workspaceId        String            @db.Uuid
  instagramAccountId String            @db.Uuid
  ruleId             String?           @db.Uuid
  flowId             String?           @db.Uuid
  mediaId            String?           @db.Uuid
  conversationId     String?           @db.Uuid
  webhookEventId     String?           @db.Uuid
  trigger            AutomationTrigger
  /// Guarantees at-most-once side effects, e.g. "private_reply:<commentId>"
  idempotencyKey     String            @unique @db.VarChar(255)
  igCommentId        String?           @db.VarChar(64)
  matchedKeyword     String?           @db.VarChar(100)
  status             ExecutionStatus   @default(PENDING)
  skipReason         String?
  attempts           Int               @default(0)
  /// Sanitised Meta API response (never contains tokens)
  apiResponse        Json?
  error              String?
  createdAt          DateTime          @default(now())
  completedAt        DateTime?

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  rule             AutomationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  flow             AutomationFlow?  @relation(fields: [flowId], references: [id], onDelete: SetNull)
  media            InstagramMedia?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  conversation     Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  webhookEvent     WebhookEvent?    @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, ruleId, status])
  @@index([workspaceId, status, createdAt])
}

model UsageRecord {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  metric      UsageMetric
  quantity    Int
  /// UTC day bucket for aggregation and plan limits
  periodDay   DateTime    @db.Date
  metadata    Json?
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, periodDay])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null for user-level events (e.g. login) not tied to a workspace
  workspaceId String?  @db.Uuid
  actorId     String?  @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String?  @db.VarChar(60)
  targetId    String?  @db.VarChar(64)
  metadata    Json?
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(512)
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}
